<bpmn:outgoing>F8</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="D_kdo" name="Kdo vodi ta hotel; pri verigi ne CEO skupine">
<bpmn:incoming>F6</bpmn:incoming>
<bpmn:outgoing>F9</bpmn:outgoing>
</bpmn:serviceTask>
