<bpmn:startEvent id="Start" name="Luknja: manjka odločevalec ali kontakt">
<bpmn:outgoing>F0</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:serviceTask id="S_brief" name="Brief s celim katalogom in batch 7 do 13 hotelov">
<bpmn:incoming>F0</bpmn:incoming>
<bpmn:outgoing>F1</bpmn:outgoing>
</bpmn:serviceTask>
