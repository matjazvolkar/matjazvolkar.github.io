<bpmn:collaboration id="Kolaboracija">
<bpmn:participant id="P_nevron" name="Nevron: AI SDR, SI Dream 100 K1" processRef="Proces_si_k1"/>
<bpmn:participant id="P_hotel" name="Hotel (odločevalec)"/>
<bpmn:messageFlow id="M_e1" name="E1, povabilo" sourceRef="T_e1" targetRef="P_hotel"/>
<bpmn:messageFlow id="M_naslednji" name="E2 do E5" sourceRef="T_naslednji" targetRef="P_hotel"/>
<bpmn:messageFlow id="M_odgovor" name="odgovor" sourceRef="P_hotel" targetRef="E_odgovor"/>
<bpmn:messageFlow id="M_nasodgovor" name="naš odgovor" sourceRef="T_odgovor" targetRef="P_hotel"/>
</bpmn:collaboration>
<bpmn:process id="Proces_si_k1" name="En hotel skozi eno kampanjo" isExecutable="false">
<bpmn:laneSet id="Steze">
<bpmn:lane id="L_matjaz" name="Matjaž (odobritve)">
<bpmn:flowNodeRef>T_pregled</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G_da</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_potrdi</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G_izid</bpmn:flowNodeRef>
<bpmn:flowNodeRef>End_sestanek</bpmn:flowNodeRef>
<bpmn:flowNodeRef>End_nurture</bpmn:flowNodeRef>
<bpmn:flowNodeRef>End_odjava</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_amadej" name="Amadej (demo aplikacije)">
<bpmn:flowNodeRef>T_tenant</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_ai" name="Claude seje in AI agenti">
<bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_drago</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_tereza</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G_test</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_izris</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_triaza</bpmn:flowNodeRef>
<bpmn:flowNodeRef>SP_zarja</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_sistem" name="Sistem: avtomatika, Instantly, HeyReach">
<bpmn:flowNodeRef>T_baze</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_skrapp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G_mail</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_nalozi</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_e1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G_cakaj</bpmn:flowNodeRef>
