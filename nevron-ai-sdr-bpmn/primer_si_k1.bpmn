<bpmn:flowNodeRef>End_tisina</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_naslednji</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_stop</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_odgovor</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="Start" name="Hotel izbran v Dream 100">
<bpmn:outgoing>F0</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:scriptTask id="T_baze" name="Poišči kontakte v bazah podatkov">
<bpmn:incoming>F0</bpmn:incoming>
<bpmn:outgoing>F1</bpmn:outgoing>
<bpmn:property id="Prop_baze" name="__targetRef_placeholder"/>
<bpmn:dataInputAssociation id="DIA_DS_attio"><bpmn:sourceRef>DS_attio</bpmn:sourceRef><bpmn:targetRef>Prop_baze</bpmn:targetRef></bpmn:dataInputAssociation>
<bpmn:dataInputAssociation id="DIA_DS_apollo"><bpmn:sourceRef>DS_apollo</bpmn:sourceRef><bpmn:targetRef>Prop_baze</bpmn:targetRef></bpmn:dataInputAssociation>
<bpmn:dataInputAssociation id="DIA_DS_lusha"><bpmn:sourceRef>DS_lusha</bpmn:sourceRef><bpmn:targetRef>Prop_baze</bpmn:targetRef></bpmn:dataInputAssociation>
<bpmn:dataInputAssociation id="DIA_DS_fullenrich"><bpmn:sourceRef>DS_fullenrich</bpmn:sourceRef><bpmn:targetRef>Prop_baze</bpmn:targetRef></bpmn:dataInputAssociation>
</bpmn:scriptTask>
<bpmn:serviceTask id="T_drago" name="Drago: preveri in dopolni, kar baze nimajo">
<bpmn:incoming>F1</bpmn:incoming>
<bpmn:incoming>F5</bpmn:incoming>
<bpmn:outgoing>F2</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:scriptTask id="T_skrapp" name="Preveri mail s kontrolnim naslovom (Skrapp)">
<bpmn:incoming>F2</bpmn:incoming>
<bpmn:outgoing>F3</bpmn:outgoing>
</bpmn:scriptTask>
<bpmn:exclusiveGateway id="G_mail" name="Naslov dokazan?">
<bpmn:incoming>F3</bpmn:incoming>
<bpmn:outgoing>F4</bpmn:outgoing>
<bpmn:outgoing>F5</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:manualTask id="T_tenant" name="Izdelaj demo aplikacijo hotela (scrape tenant)">
<bpmn:incoming>F4</bpmn:incoming>
<bpmn:incoming>F9</bpmn:incoming>
<bpmn:outgoing>F6</bpmn:outgoing>
</bpmn:manualTask>
<bpmn:serviceTask id="T_tereza" name="Tereza: trojni test AI pomočnika">
<bpmn:incoming>F6</bpmn:incoming>
<bpmn:outgoing>F7</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="G_test" name="3 od 3 pravilno?">
<bpmn:incoming>F7</bpmn:incoming>
<bpmn:outgoing>F8</bpmn:outgoing>
<bpmn:outgoing>F9</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="T_izris" name="Izriši E1 do E5 iz masterjev in dosjeja">
<bpmn:incoming>F8</bpmn:incoming>
<bpmn:incoming>F13</bpmn:incoming>
<bpmn:outgoing>F10</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="T_pregled" name="Preglej besedila vala in Excel">
<bpmn:incoming>F10</bpmn:incoming>
<bpmn:outgoing>F11</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="G_da" name="Odobreno?">
<bpmn:incoming>F11</bpmn:incoming>
<bpmn:outgoing>F12</bpmn:outgoing>
<bpmn:outgoing>F13</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:scriptTask id="T_nalozi" name="Naloži lead, predštartne preverbe">
<bpmn:incoming>F12</bpmn:incoming>
<bpmn:outgoing>F14</bpmn:outgoing>
</bpmn:scriptTask>
<bpmn:userTask id="T_start" name="Start kampanje">
<bpmn:incoming>F14</bpmn:incoming>
<bpmn:outgoing>F15</bpmn:outgoing>
</bpmn:userTask>
<bpmn:sendTask id="T_e1" name="Pošlji E1 in LinkedIn povabilo">
<bpmn:incoming>F15</bpmn:incoming>
<bpmn:incoming>F32</bpmn:incoming>
<bpmn:outgoing>F16</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:eventBasedGateway id="G_cakaj">
<bpmn:incoming>F16</bpmn:incoming>
<bpmn:incoming>F22</bpmn:incoming>
<bpmn:outgoing>F17</bpmn:outgoing>
<bpmn:outgoing>F18</bpmn:outgoing>
</bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="E_timer" name="3 delovni dnevi">
<bpmn:incoming>F17</bpmn:incoming>
<bpmn:outgoing>F19</bpmn:outgoing>
<bpmn:timerEventDefinition id="TD_timer"><bpmn:timeDuration>P3D</bpmn:timeDuration></bpmn:timerEventDefinition>
</bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="E_odgovor" name="Odgovor prispe">
<bpmn:incoming>F18</bpmn:incoming>
<bpmn:outgoing>F23</bpmn:outgoing>
<bpmn:messageEventDefinition id="MD_odgovor"/>
</bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="G_se" name="Ostal še mail?">
<bpmn:incoming>F19</bpmn:incoming>
<bpmn:outgoing>F20</bpmn:outgoing>
<bpmn:outgoing>F21</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="End_tisina" name="Sekvenca končana brez odgovora">
<bpmn:incoming>F20</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sendTask id="T_naslednji" name="Pošlji naslednji mail (E2 do E5)">
<bpmn:incoming>F21</bpmn:incoming>
<bpmn:outgoing>F22</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:scriptTask id="T_stop" name="Ustavi ves hotel na vseh kanalih">
<bpmn:incoming>F23</bpmn:incoming>
<bpmn:outgoing>F24</bpmn:outgoing>
</bpmn:scriptTask>
<bpmn:serviceTask id="T_triaza" name="Seja Inbound: triaža in osnutek odgovora">
<bpmn:incoming>F24</bpmn:incoming>
<bpmn:outgoing>F25</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="T_potrdi" name="Potrdi besedilo odgovora">
<bpmn:incoming>F25</bpmn:incoming>
<bpmn:outgoing>F26</bpmn:outgoing>
</bpmn:userTask>
<bpmn:sendTask id="T_odgovor" name="Pošlji odgovor v isto nit">
<bpmn:incoming>F26</bpmn:incoming>
<bpmn:outgoing>F27</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:exclusiveGateway id="G_izid" name="Kaj je odgovoril?">
<bpmn:incoming>F27</bpmn:incoming>
<bpmn:outgoing>F28</bpmn:outgoing>
<bpmn:outgoing>F29</bpmn:outgoing>
<bpmn:outgoing>F30</bpmn:outgoing>
<bpmn:outgoing>F31</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="End_sestanek" name="Sestanek dogovorjen">
<bpmn:incoming>F28</bpmn:incoming>
</bpmn:endEvent>
<bpmn:endEvent id="End_nurture" name="Nurture z datumom ponovnega stika">
<bpmn:incoming>F29</bpmn:incoming>
</bpmn:endEvent>
<bpmn:endEvent id="End_odjava" name="Ustavljeno, odjava povsod">
<bpmn:incoming>F30</bpmn:incoming>
</bpmn:endEvent>
<bpmn:subProcess id="SP_zarja" name="Zarja: zamenjava odločevalca">
<bpmn:incoming>F31</bpmn:incoming>
<bpmn:outgoing>F32</bpmn:outgoing>
<bpmn:startEvent id="Z_start" name="Pravi odločevalec je nekdo drug">
<bpmn:outgoing>ZF0</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:serviceTask id="Z_stop" name="Zarja: ustavi staro osebo na vseh kanalih">
<bpmn:incoming>ZF0</bpmn:incoming>
<bpmn:outgoing>ZF1</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:scriptTask id="Z_attio" name="Poišči drugo osebo v Attiu">
<bpmn:incoming>ZF1</bpmn:incoming>
<bpmn:outgoing>ZF2</bpmn:outgoing>
</bpmn:scriptTask>
<bpmn:exclusiveGateway id="Z_g1" name="Oseba najdena?">
<bpmn:incoming>ZF2</bpmn:incoming>
<bpmn:outgoing>ZF3</bpmn:outgoing>
<bpmn:outgoing>ZF4</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="Z_drago" name="Drago: poišči novega odločevalca">
<bpmn:incoming>ZF4</bpmn:incoming>
<bpmn:incoming>ZF8</bpmn:incoming>
<bpmn:outgoing>ZF5</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:scriptTask id="Z_skrapp" name="Preveri mail s kontrolnim naslovom (Skrapp)">
<bpmn:incoming>ZF3</bpmn:incoming>
<bpmn:incoming>ZF5</bpmn:incoming>
<bpmn:outgoing>ZF6</bpmn:outgoing>
</bpmn:scriptTask>
<bpmn:exclusiveGateway id="Z_g2" name="Naslov dokazan?">
<bpmn:incoming>ZF6</bpmn:incoming>
<bpmn:outgoing>ZF7</bpmn:outgoing>
<bpmn:outgoing>ZF8</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="Z_dosje" name="Zarja: nova oseba v dosje, izriši E1 in LinkedIn noto">
<bpmn:incoming>ZF7</bpmn:incoming>
<bpmn:incoming>ZF13</bpmn:incoming>
<bpmn:outgoing>ZF9</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="Z_advisor" name="Advisor: pregled pred vstavitvijo">
<bpmn:incoming>ZF9</bpmn:incoming>
<bpmn:outgoing>ZF10</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="Z_potrdi" name="Matjaž: potrdi besedila za novo osebo">
<bpmn:incoming>ZF10</bpmn:incoming>
<bpmn:outgoing>ZF11</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="Z_g3" name="Odobreno?">
<bpmn:incoming>ZF11</bpmn:incoming>
<bpmn:outgoing>ZF12</bpmn:outgoing>
<bpmn:outgoing>ZF13</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="Z_vstavi" name="Zarja: vstavi osebo v živo kampanjo (Instantly, HeyReach)">
<bpmn:incoming>ZF12</bpmn:incoming>
<bpmn:outgoing>ZF14</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="Z_end" name="Nova oseba v kampanji">
<bpmn:incoming>ZF14</bpmn:incoming>
</bpmn:endEvent>
